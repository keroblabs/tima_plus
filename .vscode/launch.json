{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SDL (Waypipe)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "-r", "devel/umac/rom.bin",
                "-s", "devel/umac/HD10_512.hda"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "SDL_VIDEODRIVER", "value": "wayland" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "setup-wayland-env",
            "envFile": "${workspaceFolder}/.wayland.env"
        }
    ]
}
